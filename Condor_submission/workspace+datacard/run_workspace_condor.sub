# run_workspace_condor.sub
#
# Submits one Condor job per (mX, year) pair listed in
# workspace_condor_args.txt (one pair per line, e.g. "450 2023"), each
# job building ONE year's workspace/datacard set for ONE mX value.
#
# Split by year as well as mX (not just mX) so each job only does 1/3
# the work of a full 3-year build and every (mX, year) pair can run
# genuinely in parallel -- a per-mX-only job would still process its
# three years sequentially inside itself, gaining nothing from Condor
# beyond parallelizing across mX values.
#
# Create workspace_condor_args.txt first, e.g. for just mX=450, all
# three years:
#   printf "450 2022\n450 2023\n450 2024\n" > workspace_condor_args.txt
# or generate it for a broader rebuild with a small loop, e.g.:
#   > workspace_condor_args.txt
#   for MX in 300 320 350 400 450 500 550 600 650 700 750 800 850 900 950 1000; do
#     for YEAR in 2022 2023 2024; do
#       echo "${MX} ${YEAR}" >> workspace_condor_args.txt
#     done
#   done
#
# Submit with:
#   condor_submit run_workspace_condor.sub
#
# Monitor with:
#   condor_q

universe                = vanilla
executable              = workspace_condor_wrapper.sh

MassX                   = $(mass_x)
Year                    = $(year)
arguments               = $(MassX) $(Year)

output                  = condor_logs/workspace_mX$(MassX)_$(Year).out
error                   = condor_logs/workspace_mX$(MassX)_$(Year).err
log                     = condor_logs/workspace_mX$(MassX)_$(Year).log

should_transfer_files   = NO
getenv                  = False

request_cpus            = 1
request_memory          = 4000M

+JobFlavour             = "tomorrow"

queue mass_x,year from workspace_condor_args.txt